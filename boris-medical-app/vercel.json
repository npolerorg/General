{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/research/digest",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "app/api/research/digest/route.ts": {
      "maxDuration": 300
    },
    "app/api/research/analyze/route.ts": {
      "maxDuration": 120
    },
    "app/api/research/chat/route.ts": {
      "maxDuration": 60
    }
  }
}
